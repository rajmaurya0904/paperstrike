# Optional — you can do all of this from Settings in the app instead.
# Keys you enter there are verified with the broker and saved to this file.

# Which broker feeds live data: upstox | groww
BROKER=

# Upstox — https://account.upstox.com/developer/apps
# Set the app's redirect URL to http://localhost:8000/auth/upstox/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback
# daily token (expires 03:30 IST) — filled in by "Log in with Upstox"
UPSTOX_ACCESS_TOKEN=

# Groww — https://groww.in/trade-api (needs a plan with live data)
# GROWW_AUTH: totp (recommended) | approval | token
GROWW_AUTH=
GROWW_API_KEY=
GROWW_TOTP_SECRET=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
